<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="F1WeatherStatus.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Paleta: fundo branco com destaque vermelho de baixa saturação -->
            <Color x:Key="Primaria">#B05A5A</Color>
            <Color x:Key="Vermelho">#B05A5A</Color>
            <Color x:Key="Fundo">#FFFFFF</Color>
            <Color x:Key="Texto">#1F1F24</Color>
            <Color x:Key="Cinza">#6E6E7A</Color>
            <Color x:Key="FundoCartao">#F7F7FA</Color>
            <Color x:Key="BordaCartao">#E4E4EA</Color>

            <!-- Todas as páginas (inclusive as que herdam de BasePage) com fundo branco -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Fundo}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Cinza}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Fundo}" />
            </Style>

            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Cinza}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Fundo}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Fundo}" />
            </Style>

            <Style x:Key="Cartao" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource BordaCartao}" />
                <Setter Property="BackgroundColor" Value="{StaticResource FundoCartao}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="Titulo" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>

            <Style x:Key="Subtitulo" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource Cinza}" />
            </Style>

            <Style x:Key="Rotulo" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>

            <Style x:Key="Destaque" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Primaria}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primaria}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

            <Style TargetType="ActivityIndicator">
                <Setter Property="Color" Value="{StaticResource Primaria}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
